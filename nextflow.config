
//                     nextflow based MNase-seq pipeline config


// container settings

params.container_engine = 'docker' // docker (default) or singularity
process.container = 'uschwartz/core_docker:v1.0'

// Optional host directory to bind as the container's /tmp. Set this on large-genome
// runs where per-tool scratch (deeptools temp BAMs, matplotlib cache, ...) would
// otherwise fill the small /tmp inside the container and crash with
// "No space left on device: '/tmp/_deeptools_*'". Create the directory first, e.g.
//   mkdir -p /mnt/bigdisk/nxf_tmp
//   nextflow run ... --scratch_dir /mnt/bigdisk/nxf_tmp
params.scratch_dir = false

if (params.container_engine == 'singularity') {
    singularity {
        enabled = true
        autoMounts = true
    }
    docker.enabled = false
    if (params.scratch_dir) { singularity.runOptions = "-B ${params.scratch_dir}:/tmp" }
}

if (params.container_engine == 'docker') {
    docker {
        enabled = true
        runOptions = '-u $(id -u):$(id -g)'
    }
    singularity.enabled = false
    if (params.scratch_dir) { docker.temp = params.scratch_dir }
}

// Error handling for invalid container engine
if (params.container_engine != 'docker' && params.container_engine != 'singularity') {
    System.err.println("ERROR: Invalid container engine: '${params.container_engine}'. Please use either 'docker' or 'singularity'.")
    System.exit(1)
}



// Global default params, used in configs
params {
  //                    Workflow
  analysis="profiler"
  inspector=false

  //                    Directories
  // path to Input
  csvInput="$projectDir/toyData/samples_profiler.csv"
  // path to Output
  outDir="$HOME/nucDetective_test/"
  // path to project
  project="$projectDir"
  // path to pipeline running reports
  tracedir = "${params.outDir}/pipeline_info"
  // path to bowtie2 index
  genomeIdx="$projectDir/toyData/Bowtie2Index/genome_chr3R"
  // path to chrSizes
  chrSizes="$projectDir/toyData/chrom_Sizes.txt"


  //                    Options
  help=false
  // path to reference file for TSS plots
  TSS=false
  //Path to file for filtering regions
  //blacklist="$projectDir/toyData/dm3-blacklist_Chromosomes.bed"
  blacklist=false
  //efective genome size for normalisation
  genomeSize= 3000000
  // whether to publish bam files
  publishBam=false
  // whether to publish size selected bam files
  publishBamFlt=true
  // whether to publish wig files
  OmitPublishWig=false
  // test RUN with toyData
  test = false
  //filter MAPQC
  MAPQC=20
  // length for mono-nucleosome selection
  minLen=140
  maxLen=200
  // NRL number of peaks used
  peaks_used = 7
  // detect nucleosome shifts
  detect_shift=true
  //normalize profiles
  normalize_profiles=true
  //use reference map for regularity
  regularity_ref=true
  //regions for NRL_regions
  nrl_regions=false
  //average NRL used in nucleosome regularity analysis
  avgNRL=180
  // consensus reference map: a nucleosome must be top20 in >= this many samples to
  // enter NucPosRef_top20.bed. 1 = original behaviour (union of all samples' top20);
  // raise for many-sample / large-genome runs where the union is ~every nucleosome.
  nucref_min_support=1

  //                    Resource ceilings
  // Upper bounds for a single task. Per-process requests below are clamped to
  // these by check_max(). Defaults are set high enough that nothing is clamped
  // on a typical workstation/server, so pipeline behaviour is unchanged out of
  // the box; lower them (e.g. --max_cpus 16) to fit a smaller machine or queue.
  max_memory = 450.GB
  max_cpus   = 64
  max_time   = 240.h

}

// change optional params for test RUN with toyData

if (params.test) {
  params.TSS = "$projectDir/toyData/dm3.refGene_chr3R_cut.gtf"
  params.blacklist = "$projectDir/toyData/dm3-blacklistChromosomes_chr3R_cut.bed"

  //additional options for Profiler test RUN
  if (params.analysis == "profiler") {
    params.csvInput = "$projectDir/toyData/samples_profiler.csv"
    params.outDir="$launchDir/Profiler_test"
    params.tracedir = "${params.outDir}/pipeline_info"
    params.peaks_used = 3
    }
  if (params.analysis == "inspector") {
    params.csvInput = "$projectDir/toyData/samples_inspector.csv"
    params.outDir="$launchDir/Inspector_test"
    params.tracedir = "${params.outDir}/pipeline_info"
    params.normalize_profiles=false
    }
}


// Clamp a per-process resource request to the configured ceiling.
// Standard nf-core helper (functions defined here are in scope for the
// process{} closures below, but not for directive closures inside modules/,
// which is why all resource logic lives in this file).
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Invalid max_memory '${params.max_memory}', using requested value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Invalid max_time '${params.max_time}', using requested value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) {
            println "   ### ERROR ###   Invalid max_cpus '${params.max_cpus}', using requested value: $obj"
            return obj
        }
    }
}


process {

    // On out-of-memory / transient kill (137 = SIGKILL/OOM, 140 = time limit, ...)
    // retry the task with more memory instead of aborting the whole run.
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 3

    withLabel: big {
        cpus = 4
    }
    withLabel: mid {
        cpus = 2
    }
    withLabel: small {
        cpus = 1
    }

    //                Per-process resources
    // Memory scales with (a) genome size — the > 200 Mbp branch is for large
    // genomes such as human (HeLa/MCF7) — and (b) task.attempt, so a retry after
    // an OOM kill gets 2x, then 3x, then 4x the base request. On the small test
    // genome (genomeSize 3_000_000) every process takes the small branch.
    // The large-genome bases were right-sized from a full HeLa+MCF7 run (peak_rss
    // from the execution trace); process outputs do not depend on how much
    // memory / how many cpus are requested.

    withName: 'alignment' {
        cpus   = { check_max( Runtime.runtime.availableProcessors() - (Math.round((Runtime.runtime.availableProcessors()*20)/100)), 'cpus' ) }
        memory = { check_max( (params.genomeSize > 200000000 ? 3.GB : 2.GB) * task.cpus * task.attempt, 'memory' ) }
    }
    withName: 'trimgalore' {
        memory = { check_max( 7.GB * task.attempt, 'memory' ) }
    }
    withName: 'qualimap' {
        memory = { check_max( (params.genomeSize > 200000000 ? 48.GB : 18.GB) * task.attempt, 'memory' ) }
    }
    withName: 'multiqc' {
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
    }
    withName: 'sieve' {
        memory = { check_max( (params.genomeSize > 200000000 ? 6.GB : 7.GB) * task.attempt, 'memory' ) }
    }
    withName: 'danpos' {
        memory = { check_max( (params.genomeSize > 200000000 ? 24.GB : 15.GB) * task.attempt, 'memory' ) }
    }
    withName: 'danpos_nuc' {
        memory = { check_max( (params.genomeSize > 200000000 ? 24.GB : 15.GB) * task.attempt, 'memory' ) }
    }
    withName: 'quantNorm' {
        memory = { check_max( (params.genomeSize > 200000000 ? 32.GB : 15.GB) * task.attempt, 'memory' ) }
    }
    withName: 'ref_bw' {
        memory = { check_max( (params.genomeSize > 200000000 ? 16.GB : 4.GB) * task.attempt, 'memory' ) }
    }
    withName: 'wig_to_bw' {
        memory = { check_max( (params.genomeSize > 200000000 ? 16.GB : 4.GB) * task.attempt, 'memory' ) }
    }
    withName: 'TSS_profile' {
        cpus   = { check_max( Math.round(Runtime.runtime.availableProcessors()*0.8), 'cpus' ) }
        memory = { check_max( (params.genomeSize > 200000000 ? 2.GB : 2.GB) * task.cpus * task.attempt, 'memory' ) }
    }
    withName: 'nucs2bed' {
        memory = { check_max( (params.genomeSize > 200000000 ? 12.GB : 6.GB) * task.attempt, 'memory' ) }
    }
    withName: 'reference_map' {
        memory = { check_max( (params.genomeSize > 200000000 ? 24.GB : 8.GB) * task.attempt, 'memory' ) }
    }
    withName: 'reference_map_all' {
        memory = { check_max( (params.genomeSize > 200000000 ? 72.GB : 8.GB) * task.attempt, 'memory' ) }
    }
    withName: 'score_peaks' {
        // multiBigwigSummary over a large-genome reference map (~10 M nucleosomes) is
        // the pole; -p parallelises over BED chunks, so give it many cores.
        cpus   = { check_max( (params.genomeSize > 200000000 ? 20 : 4), 'cpus' ) }
        memory = { check_max( (params.genomeSize > 200000000 ? 64.GB : 15.GB) * task.attempt, 'memory' ) }
    }
    withName: 'pca|correlation' {
        memory = { check_max( 15.GB * task.attempt, 'memory' ) }
    }
    withName: 'occupancy' {
        memory = { check_max( (params.genomeSize > 200000000 ? 64.GB : 16.GB) * task.attempt, 'memory' ) }
    }
    withName: 'shift' {
        memory = { check_max( (params.genomeSize > 200000000 ? 48.GB : 16.GB) * task.attempt, 'memory' ) }
    }
    withName: 'fuzziness' {
        memory = { check_max( (params.genomeSize > 200000000 ? 120.GB : 30.GB) * task.attempt, 'memory' ) }
    }
    withName: 'NRL' {
        memory = { check_max( (params.genomeSize > 200000000 ? 8.GB : 4.GB) * task.attempt, 'memory' ) }
    }
    withName: 'NRL_overview|compare_NRL_regions' {
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
    }
    withName: 'NRL_regions' {
        memory = { check_max( (params.genomeSize > 200000000 ? 32.GB : 16.GB) * task.attempt, 'memory' ) }
    }
    withName: 'regularity|regularity_reference' {
        // regularity.R runs the per-chromosome rolling PSD in parallel across
        // `cpus` PSOCK workers (REGULARITY_WORKERS, set by the module). Each
        // worker reads one chromosome from the bigwig and computes its spectrum
        // in gc()-bounded blocks - measured peak per worker on chr1 (~250 Mb) is
        // ~4 GB. 12 workers => ~50 GB; task.attempt scales the ceiling.
        cpus   = { check_max( (params.genomeSize > 200000000 ? 12 : 2), 'cpus' ) }
        memory = { check_max( (params.genomeSize > 200000000 ? 72.GB : 30.GB) * task.attempt, 'memory' ) }
    }
}


// ---------------------------------------------------------------------------
//  Execution profiles   (-profile <name>; comma-combine, e.g. -profile scratch,lowmem)
// ---------------------------------------------------------------------------
profiles {

    // Default: local executor, resource ceilings taken from the params above
    // (max_memory / max_cpus / max_time). Nothing to override.
    standard {
    }

    // Fit the run onto a small machine (laptop) for testing. Only lowers the
    // ceilings; every per-process request is clamped to them by check_max().
    lowmem {
        params.max_memory = 30.GB
        params.max_cpus   = 6
    }

    // Run each task in node-local scratch, then stage results back to the work
    // directory. Use when -w points at a network / slow / lock-less disk.
    // Functionally neutral - only changes where the task working area lives.
    scratch {
        process.scratch = true
    }

    // Template for a SLURM cluster - copy, uncomment, adapt to your site.
    // hpc {
    //     process.executor       = 'slurm'
    //     process.queue          = 'normal'
    //     process.clusterOptions = '--account=<acct>'
    // }
}


// reporting

manifest {
  name = 'uschwartz/nucDetective'
  author = 'Uwe Schwartz'
  description = 'Nextflow MNase-seq analysis pipeline'
  mainScript = 'main.nf'
  version = '01.0.0'
}

// pipeline reports
timeline {
  enabled = true
  overwrite = true
  file = "${params.tracedir}/execution_timeline.html"
}
report {
  enabled = true
  overwrite = true
  file = "${params.tracedir}/execution_report.html"
}
trace {
  enabled = true
  overwrite = true
  file = "${params.tracedir}/execution_trace.txt"
  trace.overwrite = true
  // include retry attempt + peak memory so OOM behaviour is visible after a run
  fields = 'task_id,hash,name,status,exit,attempt,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
