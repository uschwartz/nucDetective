// Inspector test run with toyData:  nextflow run nucDetective --analysis inspector --test
params {
  TSS                = "$projectDir/toyData/dm3.refGene_chr3R_cut.gtf"
  blacklist          = "$projectDir/toyData/dm3-blacklistChromosomes_chr3R_cut.bed"
  csvInput           = "$projectDir/toyData/samples_inspector.csv"
  outDir             = "$launchDir/Inspector_test"
  tracedir           = "$launchDir/Inspector_test/pipeline_info"
  normalize_profiles = false
}
