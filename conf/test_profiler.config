// Profiler test run with toyData:  nextflow run nucDetective --test
params {
  TSS        = "$projectDir/toyData/dm3.refGene_chr3R_cut.gtf"
  blacklist  = "$projectDir/toyData/dm3-blacklistChromosomes_chr3R_cut.bed"
  csvInput   = "$projectDir/toyData/samples_profiler.csv"
  outDir     = "$launchDir/Profiler_test"
  tracedir   = "$launchDir/Profiler_test/pipeline_info"
  peaks_used = 3
}
