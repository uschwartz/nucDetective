/*
* Help message
* Defaults are read from params, so they always match nextflow.config.
*/

def helpMessage() {
    log.info """
    nucDetective   P I P E L I N E   v${workflow.manifest.version}
    =============================
    Usage:

      nextflow run path2nucDetective/nucDetective --analysis profiler  --csvInput samples_profiler.csv  --genomeIdx path2bowtie2_idx --genomeSize <eff. genome size> --outDir path2outDir
      nextflow run path2nucDetective/nucDetective --analysis inspector --csvInput samples_inspector.csv --chrSizes chrom_Sizes.txt   --outDir path2outDir

    Test runs with the bundled toy data:
      nextflow run path2nucDetective/nucDetective --test
      nextflow run path2nucDetective/nucDetective --analysis inspector --test

    Mandatory arguments:
      --analysis           [string]  Workflow to execute: 'profiler' or 'inspector'. Run 'profiler' first. (default: ${params.analysis})
      --csvInput           [string]  Path to the comma-separated sample sheet (columns see below)

    Mandatory arguments profiler:
      --genomeIdx          [string]  Path and prefix of the bowtie2 index (minus .X.bt2)
      --genomeSize         [integer] Effective genome size, i.e. the length of the mappable genome (default: ${params.genomeSize}).
                                     Profiles are normalized to this read count (danpos dpos -c), so it sets the profile height.
                                     The inspector calls nucleosomes with a fixed height cutoff (25), so this value changes the
                                     nucleosome calls. Use the same value for all samples analysed together.
                                     Also scales task resources for genomes > 200 Mbp.
      csvInput columns:              'Sample_Name', 'path_fwdReads', 'path_revReads', 'Condition'

    Mandatory arguments inspector:
      --chrSizes           [string]  Tab-delimited file with 2 columns: 1) chr name, 2) chr size. Also published by 'profiler'
      --genomeSize         [integer] Only scales task resources for genomes > 200 Mbp; no effect on results (default: ${params.genomeSize})
      csvInput columns:              'Sample_Name', 'path_wig', 'normalize', 'Condition'. wig files are generated by 'profiler'

    General optional arguments:
      --outDir             [string]  Output directory, which will be created (default: \$HOME/nucDetective_test/)
      --TSS                [string]  Transcript annotation in GTF format to obtain TSS profiles (default: ${params.TSS})
      --container_engine   [string]  Container engine: 'docker' or 'singularity' (default: ${params.container_engine})
      --scratch_dir        [string]  Host directory bound as the container's /tmp; use for large genomes if /tmp fills up (default: ${params.scratch_dir})
      --test               [boolean] Run the selected workflow on the bundled toy data (default: ${params.test})
      --help               [boolean] Show this message and exit

    Profiler optional arguments:
      --blacklist          [string]  BED file with regions excluded from the analysis (applied when filtering the alignments) (default: ${params.blacklist})
      --MAPQC              [integer] Minimum mapping quality (default: ${params.MAPQC})
      --minLen             [integer] Minimum insert size for mono-nucleosome selection (default: ${params.minLen})
      --maxLen             [integer] Maximum insert size for mono-nucleosome selection (default: ${params.maxLen})
      --peaks_used         [integer] Number of phasogram peaks used to calculate NRLs (default: ${params.peaks_used})
      --nrl_regions        [string]  BED file with regions for which NRLs are calculated (default: ${params.nrl_regions})
      --publishBam         [boolean] Write aligned bam files to outDir (default: ${params.publishBam})
      --publishBamFlt      [boolean] Write size-selected bam files to outDir (default: ${params.publishBamFlt})
      --OmitPublishWig     [boolean] Do not write wig files to outDir (default: ${params.OmitPublishWig})

    Inspector optional arguments:
      --normalize_profiles [boolean] Normalize nucleosome profiles prior to analysis (default: ${params.normalize_profiles})
      --nucref_min_support [integer] Minimum number of samples in which a nucleosome must be in the top 20 % to enter the
                                     consensus reference map; 1 = union of all samples. Raise for many samples / large genomes (default: ${params.nucref_min_support})
      --detect_shift       [boolean] Detect shifts in nucleosome positions (default: ${params.detect_shift})
      --regularity_ref     [boolean] Use the reference map as reference positions for regularity (default: ${params.regularity_ref})
      --avgNRL             [integer] Average NRL used for nucleosome array regularity analysis (default: ${params.avgNRL})

    Resource limits (upper bound for any single task):
      --max_cpus           [integer] (default: ${params.max_cpus})
      --max_memory         [memory]  e.g. '30.GB' (default: ${params.max_memory})
      --max_time           [time]    e.g. '48.h' (default: ${params.max_time})

    Profiles (-profile <name>, combine with commas):
      lowmem               Lower the resource limits to 30 GB / 6 CPUs, e.g. for laptop tests
      scratch              Run tasks in node-local scratch; use when the work directory is on a slow or network disk
    """.stripIndent()
}
